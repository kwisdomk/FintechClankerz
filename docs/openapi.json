{
  "openapi": "3.1.0",
  "info": {
    "title": "FINTECH AI API",
    "description": "CSV import, deterministic duplicate screening, optional local/cloud Gemma explanations and human review. See docs/INTEGRATION.md in the source repository. MVP: not a fraud determination service.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "0.4.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Upload",
        "operationId": "uploadTransactions",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadTransactions"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          },
          "413": {
            "description": "CSV exceeds 10 MB"
          },
          "415": {
            "description": "Not a CSV filename"
          },
          "422": {
            "description": "Invalid encoding, columns, or no accepted rows"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "List Transactions",
        "operationId": "listTransactions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/summary": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "Summary",
        "operationId": "getSummary",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        }
      }
    },
    "/api/findings": {
      "get": {
        "tags": [
          "findings"
        ],
        "summary": "List Findings",
        "operationId": "listFindings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Finding"
                  },
                  "type": "array",
                  "title": "Response Listfindings"
                }
              }
            }
          }
        }
      }
    },
    "/api/findings/{finding_id}/explain": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Explain Finding",
        "operationId": "explainFinding",
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Finding Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Explanation"
                }
              }
            }
          },
          "404": {
            "description": "Finding not found"
          },
          "503": {
            "description": "Inference unavailable or invalid model output"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/findings/{finding_id}/review": {
      "post": {
        "tags": [
          "findings"
        ],
        "summary": "Review Finding",
        "operationId": "reviewFinding",
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Finding Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "404": {
            "description": "Finding not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_uploadTransactions": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadTransactions"
      },
      "Explanation": {
        "properties": {
          "finding_id": {
            "type": "integer",
            "title": "Finding Id"
          },
          "model_used": {
            "type": "string",
            "title": "Model Used"
          },
          "finding": {
            "type": "string",
            "title": "Finding"
          },
          "observed_evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Observed Evidence"
          },
          "possible_explanations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Possible Explanations"
          },
          "recommended_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommended Actions"
          },
          "learning": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Learning"
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "model_used",
          "finding",
          "observed_evidence",
          "possible_explanations",
          "recommended_actions",
          "learning",
          "generated_at"
        ],
        "title": "Explanation"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          },
          "finding_type": {
            "type": "string",
            "title": "Finding Type"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "evidence": {
            "items": {},
            "type": "array",
            "title": "Evidence"
          },
          "evidence_json": {
            "type": "string",
            "title": "Evidence Json"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          }
        },
        "type": "object",
        "required": [
          "id",
          "transaction_id",
          "finding_type",
          "severity",
          "evidence",
          "evidence_json",
          "status",
          "created_at",
          "date",
          "description",
          "amount",
          "currency",
          "supplier",
          "reference"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "database"
        ],
        "title": "Health"
      },
      "Review": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "finding_id": {
            "type": "integer",
            "title": "Finding Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "confirmed",
              "dismissed",
              "needs_review"
            ],
            "title": "Decision"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "finding_id",
          "decision",
          "notes",
          "reviewer",
          "created_at"
        ],
        "title": "Review"
      },
      "ReviewRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "confirmed",
              "dismissed",
              "needs_review"
            ],
            "title": "Decision"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewRequest"
      },
      "Summary": {
        "properties": {
          "transaction_count": {
            "type": "integer",
            "title": "Transaction Count"
          },
          "total_amount": {
            "type": "number",
            "title": "Total Amount"
          },
          "finding_count": {
            "type": "integer",
            "title": "Finding Count"
          },
          "open_finding_count": {
            "type": "integer",
            "title": "Open Finding Count"
          }
        },
        "type": "object",
        "required": [
          "transaction_count",
          "total_amount",
          "finding_count",
          "open_finding_count"
        ],
        "title": "Summary"
      },
      "Transaction": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "source_row": {
            "type": "integer",
            "title": "Source Row"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "date",
          "description",
          "amount",
          "currency",
          "supplier",
          "reference",
          "source_row",
          "created_at"
        ],
        "title": "Transaction"
      },
      "TransactionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "TransactionPage"
      },
      "UploadResult": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "total_records": {
            "type": "integer",
            "title": "Total Records"
          },
          "successful": {
            "type": "integer",
            "title": "Successful"
          },
          "rejected": {
            "type": "integer",
            "title": "Rejected"
          },
          "findings_detected": {
            "type": "integer",
            "title": "Findings Detected"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "message",
          "total_records",
          "successful",
          "rejected",
          "findings_detected"
        ],
        "title": "UploadResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
